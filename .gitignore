# build output
server/target/
web/.next/
web/out/
web/public/sim.wasm
web/next-env.d.ts
web/tsconfig.tsbuildinfo
node_modules/

# secrets: never commit
.env
.env.*
!.env.example
*.key
dispatch-keys*

# local artefacts
shots/
# Capture output from tools/silhouette.mjs. Evidence is regenerated, not committed.
shots*/
web/test-results/
web/playwright-report/
*.log

# Blender preview renders and bytecode. The .glb exports ARE committed (see below); these
# are review artefacts, regenerated by `node tools/blender/run.mjs scripts/<name>.py`.
tools/blender/renders/
__pycache__/

# Models are the one exception to "no binary assets" (owner amendment, Cycle 24): the
# Blender script is the source of truth and the .glb is a committed build artifact, because
# CI has no Blender and the gates validate the result rather than authoring it.
!web/public/models/*.glb

# packaged game
dist/
research/
# economy-audit generator dumps (regenerate with `cargo run -p sim --example pattern_dump`)
tools/economy-audit/*.ndjson
tools/economy-audit/*.err
