                "vec",
                "u16"
              ]
            ]
          ]
        ],
        [
          "Pong",
          [
            [
              "t",
              "u32"
            ]
          ]
        ],
        [
          "Error",
          [
            [
              "code",
              "u16"
            ],
            [
              "message",
              "string"
            ]
          ]
        ],
        [
          "RunOver",
          [
            [
              "summary",
              "RunSummary"
            ]
          ]
        ]
      ]
    }
  ],
