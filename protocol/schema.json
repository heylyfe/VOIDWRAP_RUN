      "enum": [
        [
          "Welcome",
          [
            [
              "protocol_version",
              "u16"
            ],
            [
              "player_id",
              "u32"
            ],
            [
              "tick",
              "u32"
            ]
          ]
        ],
        [
          "Level",
          [
            [
              "data",
              "LevelData"
            ]
          ]
        ],
        [
          "Snapshot",
          [
            [
              "tick",
              "u32"
            ],
            [
              "level",
              "u32"
            ],
            [
              "last_input_seq",
              "u32"
            ],
            [
