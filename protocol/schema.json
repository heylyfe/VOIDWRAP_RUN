    "PROTOCOL_VERSION": [
      "u16",
      3
    ],
    "TICK_HZ": [
      "u32",
      20
    ],
    "PHYSICS_HZ": [
      "u32",
      60
    ],
    "MAX_INPUTS_PER_MSG": [
      "u32",
      32
    ],
    "MAX_NAME_LEN": [
      "u32",
      24
    ],
    "MAX_CLIENT_MSG_BYTES": [
      "u32",
      4096
    ],
    "BTN_JUMP": [
      "u8",
      1
    ],
    "BTN_ABILITY": [
      "u8",
      2
    ],
    "BTN_INTERACT": [
      "u8",
      4
    ],
    "DEATH_VOID": [
      "u8",
      0
    ],
    "DEATH_ENEMY": [
      "u8",
      1
    ],
    "PHASE_ENEMY_DRAFT": [
      "u8",
      0
    ],
    "PHASE_PLAYING": [
      "u8",
      1
    ],
    "PHASE_REWARD_DRAFT": [
      "u8",
      2
    ],
    "PHASE_OVER": [
      "u8",
      3
    ],
    "MAX_DRAFT_PICKS": [
      "u32",
      4
    ],
    "MAX_ID_LEN": [
      "u32",
      32
    ],
    "GIFT_NORMAL": [
      "u8",
      0
    ],
    "GIFT_GOLDEN": [
      "u8",
      1
    ],
    "CARD_ENEMY": [
      "u8",
      0
    ],
    "CARD_UPGRADE": [
      "u8",
      1
    ],
    "CARD_CURSE": [
      "u8",
      2
    ]
  },
  "types": [
    {
      "name": "Vec3",
      "struct": [
        [
          "x",
          "f32"
        ],
        [
          "y",
          "f32"
        ],
        [
          "z",
          "f32"
        ]
      ]
    },
    {
      "name": "Aabb",
      "struct": [
        [
          "min",
          "Vec3"
        ],
        [
          "max",
          "Vec3"
        ]
      ]
    },
    {
      "name": "InputFrame",
      "$comment": "One fixed physics step (1/PHYSICS_HZ s) of player intent. move_x/move_z: world-space wish direction scaled to [-127,127]; the client rotates by camera yaw so the sim needs no trig.",
      "struct": [
        [
          "seq",
          "u32"
        ],
        [
          "move_x",
          "i8"
        ],
        [
          "move_z",
          "i8"
        ],
        [
          "buttons",
          "u8"
        ]
      ]
    },
    {
      "name": "ControllerState",
      "$comment": "Complete kinematic character state. Must contain everything the step function reads so client reconciliation is exact.",
      "struct": [
        [
          "pos",
          "Vec3"
        ],
        [
          "vel",
          "Vec3"
        ],
        [
          "grounded",
          "bool"
        ],
        [
          "coyote_frames",
          "u8"
